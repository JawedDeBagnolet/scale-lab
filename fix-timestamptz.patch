From eca19ae8e06bd389d30c71d8223868ffa1bd522a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 21:37:56 +0200
Subject: [PATCH] fix: replace TIMESTAMPTZ with DateTime(timezone=True) in
 models

TIMESTAMPTZ is not exported by sqlalchemy.dialects.postgresql.
Use the standard DateTime(timezone=True) which maps to TIMESTAMPTZ
in PostgreSQL.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017VdSEHBqNDyA986Y4UsWPn
---
 apps/backend/app/models/comportement.py |  8 ++++----
 apps/backend/app/models/log.py          | 12 ++++++------
 apps/backend/app/models/settings.py     | 10 +++++-----
 apps/backend/app/models/target.py       |  8 ++++----
 4 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/apps/backend/app/models/comportement.py b/apps/backend/app/models/comportement.py
index b17b5df..c425188 100644
--- a/apps/backend/app/models/comportement.py
+++ b/apps/backend/app/models/comportement.py
@@ -3,8 +3,8 @@
 import uuid
 from datetime import UTC, datetime
 
-from sqlalchemy import String, Text
-from sqlalchemy.dialects.postgresql import JSONB, TIMESTAMPTZ, UUID
+from sqlalchemy import DateTime, String, Text
+from sqlalchemy.dialects.postgresql import JSONB, UUID
 from sqlalchemy.orm import Mapped, mapped_column
 
 from app.db import Base
@@ -26,10 +26,10 @@ class Preset(Base):
     config: Mapped[dict] = mapped_column(JSONB, default=dict)
 
     created_at: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ, default=lambda: datetime.now(UTC)
+        DateTime(timezone=True), default=lambda: datetime.now(UTC)
     )
     updated_at: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ,
+        DateTime(timezone=True),
         default=lambda: datetime.now(UTC),
         onupdate=lambda: datetime.now(UTC),
     )
diff --git a/apps/backend/app/models/log.py b/apps/backend/app/models/log.py
index 8c75652..9d72349 100644
--- a/apps/backend/app/models/log.py
+++ b/apps/backend/app/models/log.py
@@ -3,8 +3,8 @@
 import uuid
 from datetime import UTC, datetime
 
-from sqlalchemy import Integer, String, Text
-from sqlalchemy.dialects.postgresql import JSONB, TIMESTAMPTZ, UUID
+from sqlalchemy import DateTime, Integer, String, Text
+from sqlalchemy.dialects.postgresql import JSONB, UUID
 from sqlalchemy.orm import Mapped, mapped_column
 
 from app.db import Base
@@ -17,7 +17,7 @@ class Event(Base):
         UUID(as_uuid=True), primary_key=True, default=uuid.uuid4
     )
     timestamp: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ, default=lambda: datetime.now(UTC), index=True
+        DateTime(timezone=True), default=lambda: datetime.now(UTC), index=True
     )
     module: Mapped[str] = mapped_column(String(50), index=True)  # comptes, posting, liens, ...
     event_type: Mapped[str] = mapped_column(String(100))  # compte.error, publish.ok, link.created, ...
@@ -41,10 +41,10 @@ class Incident(Base):
     status: Mapped[str] = mapped_column(String(20), default="open")  # open, ack, resolved
     event_count: Mapped[int] = mapped_column(Integer, default=1)
     first_seen: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ, default=lambda: datetime.now(UTC)
+        DateTime(timezone=True), default=lambda: datetime.now(UTC)
     )
     last_seen: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ, default=lambda: datetime.now(UTC)
+        DateTime(timezone=True), default=lambda: datetime.now(UTC)
     )
     solutions: Mapped[dict | None] = mapped_column(JSONB, default=list)
     related_events: Mapped[list | None] = mapped_column(JSONB, default=list)
@@ -63,5 +63,5 @@ class AlertRule(Base):
     threshold_actions: Mapped[int] = mapped_column(Integer, default=10)
     tg_enabled: Mapped[bool] = mapped_column(default=True)
     created_at: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ, default=lambda: datetime.now(UTC)
+        DateTime(timezone=True), default=lambda: datetime.now(UTC)
     )
diff --git a/apps/backend/app/models/settings.py b/apps/backend/app/models/settings.py
index a3533b1..f5da6ad 100644
--- a/apps/backend/app/models/settings.py
+++ b/apps/backend/app/models/settings.py
@@ -2,8 +2,8 @@
 
 from datetime import UTC, datetime
 
-from sqlalchemy import Boolean, Integer, String, Text
-from sqlalchemy.dialects.postgresql import JSONB, TIMESTAMPTZ
+from sqlalchemy import Boolean, DateTime, Integer, String, Text
+from sqlalchemy.dialects.postgresql import JSONB
 from sqlalchemy.orm import Mapped, mapped_column
 
 from app.db import Base
@@ -22,12 +22,12 @@ class WorkspaceSettings(Base):
     # Integration: OnlyChat
     oc_api_key: Mapped[str | None] = mapped_column(Text)
     oc_connected: Mapped[bool] = mapped_column(Boolean, default=False)
-    oc_last_sync: Mapped[datetime | None] = mapped_column(TIMESTAMPTZ)
+    oc_last_sync: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))
 
     # Integration: GetMySocial
     gms_api_key: Mapped[str | None] = mapped_column(Text)
     gms_connected: Mapped[bool] = mapped_column(Boolean, default=False)
-    gms_last_sync: Mapped[datetime | None] = mapped_column(TIMESTAMPTZ)
+    gms_last_sync: Mapped[datetime | None] = mapped_column(DateTime(timezone=True))
 
     # Integration: Telegram alert bot
     tg_bot_token: Mapped[str | None] = mapped_column(Text)
@@ -41,7 +41,7 @@ class WorkspaceSettings(Base):
     notifications: Mapped[dict | None] = mapped_column(JSONB, default=dict)
 
     updated_at: Mapped[datetime] = mapped_column(
-        TIMESTAMPTZ,
+        DateTime(timezone=True),
         default=lambda: datetime.now(UTC),
         onupdate=lambda: datetime.now(UTC),
     )
