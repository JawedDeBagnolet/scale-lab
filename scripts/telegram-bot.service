[Unit]
Description=ScaleCrew Telegram Bot
After=network.target scalelab-api.service
Wants=scalelab-api.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/telegram_bot.py
WorkingDirectory=/root
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
