+          onConfirm={() => del.mutate(deleting.id, { onSuccess: () => setDeleting(null) })}
+        />
+      )}
+
+      {showBulk && <BulkImportModal onClose={() => setShowBulk(false)} />}
+    </>
+  )
 }
