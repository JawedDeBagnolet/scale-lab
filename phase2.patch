+        <div className="grid grid-cols-2 gap-4">
+          <div>
+            <label className="label">Nom</label>
+            <input
+              className="field"
+              value={form.name}
+              onChange={(e) => setForm({ ...form, name: e.target.value })}
+              autoFocus
+            />
+          </div>
+          <div>
+            <label className="label">Description</label>
+            <input
+              className="field"
+              value={form.description ?? ''}
+              placeholder="Optionnel"
