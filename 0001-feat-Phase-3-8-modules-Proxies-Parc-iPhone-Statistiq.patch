+    name: Mapped[str] = mapped_column(String(100))
+    days: Mapped[list | None] = mapped_column(JSONB, default=list)  # [0..6] lundi=0
+    ranges: Mapped[list[dict] | None] = mapped_column(JSONB, default=list)  # [{start: "08:00", end: "12:00"}]
